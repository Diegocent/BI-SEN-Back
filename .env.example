# Base de datos NUEVA. No uses acá las credenciales del Neon de producción.

# --- Opción A: Postgres local (docker compose de ingesta_sen/infra) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sen_dw_dev
DB_USER=sen
DB_PASSWORD=sen_dev_local
DB_HOST=127.0.0.1
DB_PORT=5434
DB_SSLMODE=disable

# Alias que leen los scripts de ETL (etl_script.py, inicializar_dw.py,
# cargar_historico_a_ingesta.py).
DB_DW_NAME=sen_dw_dev
DB_DW_USER=sen
DB_DW_PASS=sen_dev_local
DB_DW_HOST=127.0.0.1
DB_DW_PORT=5434
DB_DW_SSLMODE=disable

# --- Opción B: Neon nuevo (reemplazar lo de arriba) ---
# DB_NAME=sen_dw_dev
# DB_USER=...
# DB_PASSWORD=...
# DB_HOST=ep-....neon.tech
# DB_PORT=5432
# DB_SSLMODE=require
# DB_DW_NAME=sen_dw_dev
# DB_DW_USER=...
# DB_DW_PASS=...
# DB_DW_HOST=ep-....neon.tech
# DB_DW_PORT=5432
# DB_DW_SSLMODE=require

SECRET_KEY=cambiar-por-una-clave-local
DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
